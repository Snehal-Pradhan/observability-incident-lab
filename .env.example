# Copy to .env and adjust. Never commit .env.

# API
HTTP_PORT=8080
LOG_LEVEL=info
CACHE_TTL_SECONDS=300
DB_MAX_CONNS=10

# Postgres (used by seed/migrations running on the host; the api container
# gets its DATABASE_URL from docker-compose.yml)
POSTGRES_USER=orders
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orders
POSTGRES_PORT=5432
DATABASE_URL=postgres://orders:change-me@localhost:5432/orders?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PORT=6379
SLACK_WEBHOOK_URL=ttps://hooks.slack.com/services/...
